{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "field-shift",
  "main": "apps/api/src/index.ts",
  "compatibility_date": "2026-10-01",

  // Static frontend (Vite build). Requests to /api/* always go to the Worker first.
  "assets": {
    "directory": "apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // KV cache for climate / soil / field lookups.
  // Create once:  npx wrangler kv namespace create CACHE
  // then paste the printed id below (local `npm run dev` works without it).
  "kv_namespaces": [
    { "binding": "CACHE", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }
  ],

  // Optional R2 bucket for large files (field-boundary PMTiles, Koppen tiles).
  // Create once:  npx wrangler r2 bucket create field-shift-tiles   and uncomment.
  // "r2_buckets": [
  //   { "binding": "TILES", "bucket_name": "field-shift-tiles" }
  // ],

  "observability": { "enabled": true }
}
